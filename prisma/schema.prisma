generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use a pooled connection for the app, and a direct one for migrations
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LEAD
  MEMBER
}

enum TaskType {
  TEXT
  LINK
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskReviewStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  ANNUAL
}

enum GoalCategory {
  CORE
  BEHAVIOURAL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users      User[]
  tasks      Task[]
  goals      Goal[]
  objectives Objective[]
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  archivedAt   DateTime?
  authVersion  Int      @default(0)
  role         Role     @default(MEMBER)
  jobTitle     String?
  departmentId String?
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks       Task[]
  goals       Goal[]
  manualScores ManualScore[] @relation("ScoredUser")
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  title     String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

// A department's monthly "why" - what its KPIs are actually in service of.
// Progress comes from two places: any Goals (KPIs) linked to it, and any
// tasks members tag to it directly. Both are optional; an objective with
// neither just shows as "no progress data yet".
model Objective {
  id               String   @id @default(cuid())
  departmentId     String
  title            String
  description      String?  @db.Text
  targetTaskCount  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  goals      Goal[]
  tasks      Task[]

  @@index([departmentId])
}

// A KPI target. Exactly one of departmentId / userId is set:
// - departmentId set, userId null  -> default target for everyone in that department
// - userId set, departmentId null  -> individual override for one member (wins over the department default for that period)
model Goal {
  id           String       @id @default(cuid())
  departmentId String?
  userId       String?
  objectiveId  String?
  period       GoalPeriod
  targetCount  Int
  weight       Float        @default(1)
  category     GoalCategory @default(CORE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@unique([departmentId, period])
  @@unique([userId, period])
}

// A manager's subjective 0-10 rating of a person on some competency
// (teamwork, communication, judgement calls) that no task count can capture.
// Feeds the "Behavioural" half of the composite score.
model ManualScore {
  id          String   @id @default(cuid())
  userId      String
  scorerId    String?
  scorerName  String
  competency  String
  score       Float
  periodLabel String // e.g. "2026-09" - the month this score applies to
  notes       String?  @db.Text
  ratingKey   String?  @unique
  supersededAt DateTime?
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  user User @relation("ScoredUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([periodLabel])
}

// Snapshot-based audit trail. actorId/actorName are stored as plain values
// (not a FK relation) so log entries survive even if the actor is later removed.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String
  targetLabel String
  targetId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Task {
  id             String        @id @default(cuid())
  userId         String
  departmentId   String?
  objectiveId    String?
  type           TaskType
  content        String        @db.Text
  taskDate       DateTime      @db.Date
  status         TaskStatus    @default(PENDING)
  reviewStatus   TaskReviewStatus @default(DRAFT)
  assignedById   String?
  assignedByName String?
  assignedAt     DateTime?
  submissionText String?       @db.Text
  submittedAt    DateTime?
  reviewFeedback String?       @db.Text
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  legacyApproved Boolean       @default(false)
  legacyAssigned Boolean       @default(false)
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledByName String?
  cancellationReason String?   @db.Text
  completedAt    DateTime?
  version        Int           @default(0)
  category       String?
  chapter        String?
  campaign       String?
  priority       TaskPriority?
  dueDate        DateTime?     @db.Date
  deliveredDate  DateTime?     @db.Date
  revisionRounds Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([departmentId])
  @@index([taskDate])
  @@index([status])
  @@index([userId, status, taskDate])
  @@index([departmentId, taskDate])
  @@index([objectiveId, status, taskDate])
  @@index([departmentId, reviewStatus, taskDate])
  @@index([cancelledAt])
}

// Immutable scope snapshots survive deleting the current goal or department.
// The latest revision at a period's start is that period's target.
model GoalRevision {
  id            String       @id @default(cuid())
  goalId        String
  departmentId  String?
  userId        String?
  objectiveId   String?
  period        GoalPeriod
  targetCount   Int
  category      GoalCategory
  weight        Float
  effectiveFrom DateTime     @db.Date
  retired       Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@unique([goalId, effectiveFrom])
  @@index([period, effectiveFrom])
}

// Closed months are immutable reports; corrections to source data remain audited.
model MonthlyReport {
  periodLabel String   @id
  finalizedBy String
  finalizedAt DateTime @default(now())
  rows        Json
}

// Shared across serverless instances; keys are hashes, never raw login emails.
model LoginAttempt {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

// Calendar-day assignment history keeps later transfers out of earlier reports.
model UserAssignment {
  id            String   @id @default(cuid())
  userId        String
  departmentId  String?
  role          Role
  archived      Boolean  @default(false)
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())
  @@unique([userId, effectiveFrom])
}
