generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use a pooled connection for the app, and a direct one for migrations
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LEAD
  MEMBER
}

enum TaskType {
  TEXT
  LINK
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users      User[]
  tasks      Task[]
  goals      Goal[]
  objectives Objective[]
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  departmentId String?
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks      Task[]
  goals      Goal[]
}

// A department's monthly "why" - what its KPIs are actually in service of.
// Progress comes from two places: any Goals (KPIs) linked to it, and any
// tasks members tag to it directly. Both are optional; an objective with
// neither just shows as "no progress data yet".
model Objective {
  id               String   @id @default(cuid())
  departmentId     String
  title            String
  description      String?  @db.Text
  targetTaskCount  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  goals      Goal[]
  tasks      Task[]

  @@index([departmentId])
}

// A KPI target. Exactly one of departmentId / userId is set:
// - departmentId set, userId null  -> default target for everyone in that department
// - userId set, departmentId null  -> individual override for one member (wins over the department default for that period)
model Goal {
  id           String     @id @default(cuid())
  departmentId String?
  userId       String?
  objectiveId  String?
  period       GoalPeriod
  targetCount  Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@unique([departmentId, period])
  @@unique([userId, period])
}

// Snapshot-based audit trail. actorId/actorName are stored as plain values
// (not a FK relation) so log entries survive even if the actor is later removed.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String
  targetLabel String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Task {
  id           String     @id @default(cuid())
  userId       String
  departmentId String?
  objectiveId  String?
  type         TaskType
  content      String     @db.Text
  taskDate     DateTime   @db.Date
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  objective  Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([departmentId])
  @@index([taskDate])
  @@index([status])
}
