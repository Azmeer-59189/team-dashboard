  "cards": [
    {
      "dot": "cyan",
      "title": "App Router surface",
      "items": [
        "Pages and layouts: /login, /account, /member/*, /admin/*",
        "API handlers: /api/auth/[...nextauth], /api/tasks, /api/admin/*, /api/objectives",
        "Server pages and handlers call Prisma directly; client components use JSON APIs"
      ]
    },
    {
      "dot": "violet",
      "title": "Credentials and access",
      "items": [
        "Credentials authorize looks up User by email and verifies passwordHash with bcrypt.compare",
        "NextAuth stores id, role, and departmentId in a JWT and exposes them in the session",
        "Middleware gates /admin and /member; API handlers independently check session and role / department scope"
      ]
    },
    {
      "dot": "emerald",
      "title": "Relational data",
      "items": [
        "Department has users, tasks, goals, and objectives; User owns tasks, goals, and manual scores",
        "Goal can target a department or a user and can link to an Objective; Objective belongs to a Department",
        "Task belongs to User and may reference Department and Objective; AuditLog snapshots actor details without a foreign key",
        "Prisma datasource is PostgreSQL: pooled DATABASE_URL for app traffic and DIRECT_URL for migrations"
      ]
    }
  ]
