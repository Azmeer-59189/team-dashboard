# Get these from your Neon project dashboard -> Connection Details
# DATABASE_URL: the pooled connection string (has "-pooler" in the host) - used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: the direct (non-pooled) connection string - used only by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run seed` to create the first admin account (optional, has defaults)
SEED_ADMIN_EMAIL="admin@company.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Admin"
