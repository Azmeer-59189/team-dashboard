# Get these from your SiteGround Site Tools -> Databases -> MySQL
# Format: mysql://username:password@host:port/database_name
# The "host" here is NOT "localhost" - SiteGround will give you a specific
# remote hostname or IP once Remote MySQL access is enabled for your database.
DATABASE_URL="mysql://dbuser:dbpassword@your-remote-mysql-host:3306/your_database_name"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run seed` to create the first admin account (optional, has defaults)
SEED_ADMIN_EMAIL="admin@company.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Admin"
